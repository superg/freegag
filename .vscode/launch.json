{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GAG [Linux, GDB]",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/freegag",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/data",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "GAG [MSVC, Debug]",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/Debug/freegag.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/data",
            "environment": [],
            "console": "internalConsole"
        },
        {
            "name": "XTET [MSVC, Debug]",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/Debug/freegag.exe",
            "args": ["--xtet"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/data",
            "environment": [],
            "console": "internalConsole"
        }
    ]
}
